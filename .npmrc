# Save exact versions instead of using ^ or ~
# This ensures all developers and CI use the exact same dependency versions
save-exact=true

# Automatically install peer dependencies
# Useful for Angular projects with many peer deps
auto-install-peers=true

# Use package-lock for consistent installs
package-lock=true

# Engine strict - fail if Node version doesn't match package.json engines
engine-strict=true

# Audit level - fail install if vulnerabilities found
# Options: info, low, moderate, high, critical, none
audit-level=moderate

# Fund messages - hide funding messages during install
fund=false

# Update notifier - disable update notifications
update-notifier=false

# Progress - show/hide progress bar during install
progress=true

# Loglevel - control logging verbosity
# Options: silent, error, warn, notice, http, info, verbose, silly
loglevel=warn

# Legacy peer deps - set to false for stricter dependency resolution
# (only enable if you have peer dependency conflicts)
legacy-peer-deps=false

# Optional - Configure registry (useful for private registries)
# registry=https://registry.npmjs.org/

# Optional - Scope-specific registry for your organization
# @dittmar:registry=https://registry.npmjs.org/

# Optional - Script shell (use bash for consistency across platforms)
# script-shell=/bin/bash

# Optional - Cache configuration
# cache=${HOME}/.npm

# Optional - Strict SSL (disable only if behind corporate proxy)
# strict-ssl=true
